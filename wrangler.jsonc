{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pufu-lens-stock",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "pufu-lens-stock-content" }],
  "workflows": [
    { "binding": "ARTICLE_WORKFLOW", "name": "stock-article", "class_name": "ArticleWorkflow" },
    { "binding": "MEMORY_WORKFLOW", "name": "stock-memory", "class_name": "MemoryWorkflow" },
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "LOCAL_DEMO_ENABLED": "false",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
  },
  "env": {
    "production": {
      "name": "pufu-lens-stock",
      "vars": {
        "APP_URL": "https://stock.example.com",
        "LOCAL_DEMO_ENABLED": "false",
        "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stock-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "pufu-lens-stock-content" }],
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "workflows": [
        { "binding": "ARTICLE_WORKFLOW", "name": "stock-article", "class_name": "ArticleWorkflow" },
        { "binding": "MEMORY_WORKFLOW", "name": "stock-memory", "class_name": "MemoryWorkflow" },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
