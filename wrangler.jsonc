{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pufu-lens-stock",
  "main": "server/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "pufu-lens-stock-content" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    {
      "name": "OAUTH_REGISTRATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "workflows": [
    { "binding": "ARTICLE_WORKFLOW", "name": "stock-article", "class_name": "ArticleWorkflow" },
    { "binding": "MEMORY_WORKFLOW", "name": "stock-memory", "class_name": "MemoryWorkflow" },
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "LOCAL_DEMO_ENABLED": "false",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
  },
  "env": {
    "production": {
      "name": "pufu-lens-stock",
      "workers_dev": true,
      "vars": {
        // Replaced from the APP_URL environment variable during production builds.
        "APP_URL": "https://app.example.invalid",
        "LOCAL_DEMO_ENABLED": "false",
        "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stock-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "pufu-lens-stock-content" }],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
      "ratelimits": [
        {
          "name": "OAUTH_REGISTRATION_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "workflows": [
        { "binding": "ARTICLE_WORKFLOW", "name": "stock-article", "class_name": "ArticleWorkflow" },
        { "binding": "MEMORY_WORKFLOW", "name": "stock-memory", "class_name": "MemoryWorkflow" },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
