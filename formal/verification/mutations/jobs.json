{
  "module": "Verification.Jobs",
  "mutations": [
    {
      "name": "B08-generation",
      "old": "owner.present = true ∧ owner.belongsToUser = true ∧ owner.revision = revision",
      "new": "owner.present = true ∧ owner.belongsToUser = true",
      "theorem": "stale_generation_preserves_memory"
    },
    {
      "name": "B08-owner-alive",
      "old": "owner.present = true ∧ owner.belongsToUser = true ∧ owner.revision = revision",
      "new": "owner.belongsToUser = true ∧ owner.revision = revision",
      "theorem": "deleted_owner_preserves_memory"
    },
    {
      "name": "B08-lease-time",
      "old": "job.status = lease.status ∧ job.attempts = lease.attempts ∧ job.updatedAt = lease.updatedAt",
      "new": "job.status = lease.status ∧ job.attempts = lease.attempts",
      "theorem": "stale_timestamp_preserves_job"
    },
    {
      "name": "B08-dispatch-user",
      "old": "(facts.cleanup = true ∨ (facts.userExists = true ∧ facts.onboarded = true))",
      "new": "(facts.cleanup = true ∨ facts.onboarded = true)",
      "theorem": "deleted_user_cannot_dispatch"
    },
    {
      "name": "B08-article-generation",
      "old": "if (s.generation == some generation) && s.belongsToUser then",
      "new": "if s.belongsToUser then",
      "theorem": "old_article_cannot_commit"
    },
    {
      "name": "B08-retire-pending",
      "old": "job.status == .pending && (current.any (fun actual => decide (revision < actual)))",
      "new": "current.any (fun actual => decide (revision < actual))",
      "theorem": "running_job_is_not_retired"
    },
    {
      "name": "B08-reanalysis-request-generation",
      "old": "s.generation == expected then",
      "new": "true then",
      "theorem": "enqueue_requires_current_generation"
    },
    {
      "name": "B08-reanalysis-running-job",
      "old": "eligible facts && running && inputsCurrent && s.pending && s.jobId == jobId",
      "new": "eligible facts && running && inputsCurrent && s.pending",
      "theorem": "stale_job_preserves_result"
    },
    {
      "name": "B08-reanalysis-memory-disabled",
      "old": "facts.owner && facts.memoryUpdates && facts.hasDetails && facts.sourcesCurrent",
      "new": "facts.owner && facts.hasDetails && facts.sourcesCurrent",
      "theorem": "revoked_memory_rejects_analysis"
    }
  ]
}
