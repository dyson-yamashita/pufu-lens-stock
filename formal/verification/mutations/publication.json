{
  "module": "Verification.Publication",
  "mutations": [
    {
      "name": "B06-private",
      "old": "s.present = true ∧ s.isPublic = true ∧ s.publicId = some key",
      "new": "s.present = true ∧ True ∧ s.publicId = some key",
      "theorem": "detail_requires_public"
    },
    {
      "name": "B06-cache-generation",
      "old": "if entry.generation = current ∧ entry.page = page then .cached current page",
      "new": "if True ∧ entry.page = page then .cached current page",
      "theorem": "cached_requires_current_generation"
    },
    {
      "name": "B06-missing-revision",
      "old": "| none => .denied",
      "new": "| none => .database",
      "theorem": "missing_revision_fail_closed"
    },
    {
      "name": "B06-footprint-copy-only",
      "old": "then f.publication else none",
      "new": "then some f.privateAnalysis else none",
      "theorem": "footprint_read_requires_approval"
    },
    {
      "name": "B06-footprint-project",
      "old": "memoryUpdates = true ∧ f.belongsToProject = true ∧",
      "new": "memoryUpdates = true ∧ True ∧",
      "theorem": "footprint_other_project_denied"
    },
    {
      "name": "B06-footprint-sources",
      "old": "f.completed = true ∧ f.sourcesCurrent = true",
      "new": "f.completed = true ∧ True",
      "theorem": "footprint_stale_source_denied"
    },
    {
      "name": "B06-footprint-memory-off",
      "old": "memoryUpdates = true ∧ f.belongsToProject",
      "new": "True ∧ f.belongsToProject",
      "theorem": "footprint_memory_off_denied"
    },
    {
      "name": "B06-footprint-edit-owner",
      "old": "if mayEdit s e ∧ footprintEligible s memoryUpdates f then { f with publication := some copy }",
      "new": "if True ∧ footprintEligible s memoryUpdates f then { f with publication := some copy }",
      "theorem": "footprint_save_denied_preserves"
    },
    {
      "name": "B06-footprint-public-analysis-provenance",
      "old": "if a.publicInputs && a.sourcesCurrent then",
      "new": "if a.sourcesCurrent then",
      "theorem": "private_inputs_never_project"
    },
    {
      "name": "B06-footprint-public-analysis-source",
      "old": "if a.publicInputs && a.sourcesCurrent then",
      "new": "if a.publicInputs then",
      "theorem": "changed_sources_never_project"
    },
    {
      "name": "B06-footprint-continuing-detail",
      "old": "some (if a.continuing then .point else .detail a.text)",
      "new": "some (.detail a.text)",
      "theorem": "continuing_projected_as_point"
    }
  ]
}
