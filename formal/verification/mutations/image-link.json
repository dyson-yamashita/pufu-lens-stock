{
  "module": "Verification.ImageLink",
  "mutations": [
    {
      "name": "B07-pending-readable",
      "old": "s.link.tokenValid = true ∧ s.link.ready = true ∧",
      "new": "s.link.tokenValid = true ∧ True ∧",
      "theorem": "readable_requires_ready"
    },
    {
      "name": "B07-final-check",
      "old": "decide (readable first before ∧ objectExists = true ∧ readable final after)",
      "new": "decide (readable first before ∧ objectExists = true ∧ True)",
      "theorem": "served_requires_final_check"
    },
    {
      "name": "B07-revision",
      "old": "c.phase = l.phase ∧ c.revision = l.revision ∧",
      "new": "c.phase = l.phase ∧ True ∧",
      "theorem": "readable_requires_revision"
    }
  ]
}
