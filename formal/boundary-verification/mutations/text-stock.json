{
  "module": "BoundaryVerification.TextStock",
  "mutations": [
    {
      "name": "B15-owner",
      "old": "s.present && (s.owner == user) && s.textSource",
      "new": "s.present && s.textSource",
      "theorem": "foreign_stock_denied"
    },
    {
      "name": "B15-article",
      "old": "edit.version.article == s.current.version.article &&\n        edit.version.generation == s.current.version.generation",
      "new": "edit.version.generation == s.current.version.generation",
      "theorem": "stale_article_denied"
    },
    {
      "name": "B15-generation",
      "old": "edit.version.article == s.current.version.article &&\n        edit.version.generation == s.current.version.generation",
      "new": "edit.version.article == s.current.version.article",
      "theorem": "stale_generation_denied"
    },
    {
      "name": "B15-copy",
      "old": "if s.otherCopy.isSome then ⟨edit.forkId, 1⟩\n  else ⟨s.current.version.article, s.current.version.generation + 1⟩",
      "new": "⟨s.current.version.article, s.current.version.generation + 1⟩",
      "theorem": "shared_edit_changes_only_target"
    },
    {
      "name": "B15-memory",
      "old": "projectMemoryRevision := s.projectMemoryRevision + 1",
      "new": "projectMemoryRevision := s.projectMemoryRevision",
      "theorem": "successful_edit_invalidates_memory"
    }
  ]
}
