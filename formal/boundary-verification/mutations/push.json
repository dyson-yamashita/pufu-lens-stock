{
  "module": "BoundaryVerification.Push",
  "mutations": [
    {
      "name": "B13-owner",
      "old": "  | some p => p.owner == user",
      "new": "  | some _ => true",
      "theorem": "other_owner_registration_rejected"
    },
    {
      "name": "B13-lease",
      "old": "  if d.lease == some lease then",
      "new": "  if true then",
      "theorem": "stale_lease_cannot_complete"
    },
    {
      "name": "B13-attempts",
      "old": "        else if retriable status && d.attempts < 5 then .pending else .failed",
      "new": "        else if retriable status && d.attempts < 6 then .pending else .failed",
      "theorem": "exhausted_retry_fails"
    },
    {
      "name": "B13-consent",
      "old": "  p.subscriptionExists && now < p.sessionExpires && p.announcementExists && p.notify &&",
      "new": "  true && now < p.sessionExpires && p.announcementExists && p.notify &&",
      "theorem": "unsubscribe_before_preflight_rejects"
    },
    {
      "name": "B13-notify-generation",
      "old": "    p.notifyAt == selectedNotifyAt && p.publishedAt ≤ now",
      "new": "    true && p.publishedAt ≤ now",
      "theorem": "notification_changed_before_preflight_rejects"
    },
    {
      "name": "B13-device-limit",
      "old": "  count < 20 || (s.subscription.any fun p => p.owner == user)",
      "new": "  count < 21 || (s.subscription.any fun p => p.owner == user)",
      "theorem": "new_device_limit_rejected"
    }
  ]
}
