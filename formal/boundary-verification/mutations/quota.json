{
  "module": "BoundaryVerification.Quota",
  "mutations": [
    {
      "name": "B11-operation-limit",
      "old": "  s.operations < c.limits.operations ∧ c.activeJobsAtReservation < c.limits.jobs ∧",
      "new": "  True ∧ c.activeJobsAtReservation < c.limits.jobs ∧",
      "theorem": "new_operation_respects_limit"
    },
    {
      "name": "B11-pending-regeneration",
      "old": " ∧ regeneration = false",
      "new": "",
      "theorem": "pending_regeneration_is_active"
    },
    {
      "name": "B11-pending-automatic-question",
      "old": "¬ (kind = .question ∧ status = .pending ∧ regeneration = false)",
      "new": "True",
      "theorem": "pending_automatic_question_is_not_active"
    },
    {
      "name": "B11-call-limit",
      "old": "  admitted c s question ∧ s.attempts < c.limits.calls ∧ s.running < c.limits.running ∧",
      "new": "  admitted c s question ∧ True ∧ s.running < c.limits.running ∧",
      "theorem": "new_call_respects_limits"
    },
    {
      "name": "B11-unknown-retry",
      "old": "    retryBlocked := decide (outcome = .unknownInvocation)",
      "new": "    retryBlocked := false",
      "theorem": "unknown_invocation_blocks_retry"
    },
    {
      "name": "B11-meter-owner",
      "old": "  if row.id = attempt ∧ row.owner = requester ∧ row.recorded = false then",
      "new": "  if row.id = attempt ∧ True ∧ row.recorded = false then",
      "theorem": "wrong_owner_cannot_save_meter"
    }
  ]
}
