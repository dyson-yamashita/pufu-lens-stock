{
  "name": "pufu-lens-stock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && npm run db:migrate:local",
    "dev": "vite --host localhost",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-local.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply stock-db --local",
    "db:migrate:production": "wrangler d1 migrations apply stock-db --remote --env production",
    "deploy": "npm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@mozilla/readability": "^0.6.0",
    "openid-client": "^6.8.8",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.2.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  }
}
