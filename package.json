{
  "name": "pufu-lens-stock",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && pnpm run db:migrate:local",
    "dev": "vite --host localhost",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test:smoke:mcp": "node scripts/smoke-mcp-local.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run format:check && pnpm run build",
    "db:migrate:local": "wrangler d1 migrations apply stock-db --local",
    "db:migrate:production": "wrangler d1 migrations apply stock-db --remote --env production --config dist/pufu_lens_stock/wrangler.json",
    "deploy": "pnpm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@goto-lab/pufu-editor": "0.9.15",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@mozilla/readability": "^0.6.0",
    "@pufu-lens/pufu-image": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "agents": "^0.28.1",
    "dom-to-image": "^2.6.0",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.11",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "ipaddr.js": "^2.2.0",
    "leader-line-new": "^1.1.9",
    "linkedom": "^0.18.12",
    "loglevel": "^1.9.1",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.0",
    "react-icons": "^5.0.1",
    "react-sortablejs": "^6.1.4",
    "react-textarea-autosize": "^8.5.9",
    "short-uuid": "^4.2.2",
    "sortablejs": "^1.15.2",
    "ts-interface-checker": "^1.0.2",
    "zod": "^4.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^9.0.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "miniflare": "^4.20260730.0",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@10.34.7"
}
