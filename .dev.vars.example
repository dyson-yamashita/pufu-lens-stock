APP_URL=http://localhost:5173
LOCAL_DEMO_ENABLED=true
# trueにすると、WranglerのCloudflare認証を使ってWorkers AIへ接続します。
# 変更後は開発サーバーを再起動してください。
WORKERS_AI_ENABLED=false
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# 同じWi-Fiの端末で試す場合は、MacのプライベートIPv4アドレスを指定します。
# LOCAL_DEMO_LAN_ORIGIN=http://192.168.1.10:5173
# Googleログインも試す場合に設定します。空欄でもローカルデモは動作します。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X APIトークン保存用AES-256キー（64文字の16進数）。本番はWrangler Secretへ設定。
# 値をGitへ追加しないでください。未設定時は登録を受け付けません。
INTEGRATION_ENCRYPTION_KEY=

# YouTubeのタイトル・説明文の取得用。YouTube Data API v3を有効化したAPIキー。
# 本番はWrangler Secretへ登録してください。空欄でも他の機能は動作します。
YOUTUBE_API_KEY=
